{
  "name": "ms-rewards-auto",
  "version": "0.9.1",
  "description": "微软积分（Microsoft Rewards）自动任务独立软件 · 多账户隔离 · 加密保险库 · 密码强度校验 · 每日活动/每周领取 · Electron GUI",
  "main": "src/electron-main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "gui": "electron .",
    "cli": "node src/main.js",
    "install-browser": "playwright-core install chromium",
    "postinstall": "playwright-core install chromium || exit 0",
    "dev:web": "vite --config src-renderer/vite.config.ts",
    "build:web": "node node_modules/vite/bin/vite.js build --config src-renderer/vite.config.ts && node scripts/clean-assets.js",
    "build:web:docker": "node node_modules/vite/bin/vite.js build --config src-renderer/vite.web.config.ts",
    "watch:web": "vite build --config src-renderer/vite.config.ts --watch",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p src-renderer/tsconfig.json",
    "pack": "electron-builder --win nsis",
    "pack:dir": "electron-builder --win nsis --dir",
    "test": "node scripts/selfcheck.js",
    "clean:assets": "node scripts/clean-assets.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ttqtt/liquid-glass-react": "^0.2.0",
    "playwright-core": "^1.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.hermlt.msrewards",
    "productName": "Microsoft Rewards Auto",
    "copyright": "MIT License",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "gui/**/*",
      "gui-react/**/*",
      "config.json",
      "package.json",
      "package-lock.json",
      "start.bat",
      "参考js脚本/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asarUnpack": [
      "node_modules/playwright-core/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Microsoft-Rewards-Auto-Setup-${version}.exe",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "afterPack": "scripts/afterPack.js",
    "nsis": {
      "oneClick": false,
      "language": "2052",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Microsoft Rewards Auto",
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "license": "MIT"
}
