{
  "name": "ms-rewards-auto",
  "version": "0.14.10",
  "buildNumber": "0",
  "description": "MS 积分（MS Rewards）自动任务独立软件 · 多账户隔离 · 加密保险库 · 密码强度校验 · 每日活动/每周领取 · Electron GUI",
  "main": "src/electron-main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "gui": "electron .",
    "cli": "node src/main.js",
    "install-browser": "playwright-core install chromium",
    "postinstall": "playwright-core install chromium || exit 0",
    "dev:web": "vite --config src-renderer/vite.config.ts",
    "build:web": "node node_modules/vite/bin/vite.js build --config src-renderer/vite.config.ts && node scripts/clean-assets.js",
    "build:web:docker": "node node_modules/vite/bin/vite.js build --config src-renderer/vite.web.config.ts",
    "watch:web": "vite build --config src-renderer/vite.config.ts --watch",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p src-renderer/tsconfig.json",
    "pack": "electron-builder --win nsis",
    "pack:dir": "electron-builder --win nsis --dir",
    "test": "node scripts/selfcheck.js",
    "verify:pack": "node scripts/verify-pack.js",
    "bump": "node scripts/bump-version.js",
    "clean:assets": "node scripts/clean-assets.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ttqtt/liquid-glass-react": "0.0.2",
    "playwright-core": "^1.45.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "com.hermlt.msrewards",
    "productName": "MS Rewards Auto",
    "copyright": "MIT License",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/web/dist/**",
      "gui/**/*",
      "gui-react/**/*",
      "!gui-react/*.png",
      "gui-react/icon.png",
      "config.json",
      "package.json",
      "package-lock.json",
      "start.bat",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/default-wallpaper.jpg",
        "to": "default-wallpaper.jpg"
      }
    ],
    "asarUnpack": [
      "node_modules/playwright-core/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MS-Rewards-Auto-Setup-${buildVersion}.exe",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "beforePack": "scripts/beforePack.js",
    "afterPack": "scripts/afterPack.js",
    "nsis": {
      "oneClick": false,
      "license": "license.txt",
      "language": "2052",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MS Rewards Auto",
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "publish": null,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  },
  "license": "MIT"
}
