# ============ 依赖 ============
node_modules/

# ============ 运行时数据（含敏感信息，严禁提交）============
# storage/ 包含账户 cookies、登录态、浏览器 profile、个人积分数据
storage/
storage-backup-migrate/

# ============ 日志 ============
logs/
*.log

# ============ WorkBuddy 工作区数据 ============
.workbuddy/

# ============ 系统/编辑器杂项 ============
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# ============ 临时文件 ============
*.tmp
*.bak
*.old

# ============ 打包产物 ============
# dist/ 是 electron-builder 的输出目录（安装包 77M，走 GitHub Release 分发）
dist/

# git bundle：服务器不能访问 github，靠 bundle 增量同步代码。
# 属一次性中转文件，每版一个，不该入库。
*.bundle

# 注意：build/ 不能忽略。它是 electron-builder 的 buildResources 目录，
# 里面的 icon.ico / icon.png 是打包必需的输入，忽略了别人 clone 后
# 执行 npm run pack 会因找不到 build/icon.ico 直接失败。

# ============ 调试与临时输出（不提交） ============
# 抓取调试产物（含真实登录会话与个人积分信息，严禁提交）
scrape-out/
scrape-profile/

# ============ 实验性 / 可行性方案（未完成，暂不入库）============
# Android / OpenWrt 仍是调研半成品。Docker/Web 已正式入库（2026-09-18）：
#   docker/（Dockerfile/compose/entrypoint/README）、.dockerignore、src/server.js、src/web/index.html。
#   只有 src/web/dist/（构建产物）继续排除。
/Android/
/OpenWrt/
/docs/*
# 例外：docs/screenshots/ 是 README 引用的正式界面图，必须跟踪。
!/docs/screenshots/
/src/web/dist/
/build/*.txt
# 例外：build/license.txt 是安装器 EULA（package.json 的 nsis.license 指向它），
# 缺了它 clone 后打包出来的安装器不弹协议页，selfcheck 也会红。
!/build/license.txt
/build/*.log
/icon-result*.txt
/icon-verify.txt
/build-web.txt
/pil-check.txt
/preview-u8.txt
/th-info.txt
/verify-out.txt
/shots/
/WinUI3Demo*/
# gui-react/ 是构建产物目录：只跟踪 index.html / assets/ / icon.png，
# 验证用的截图（*-login.png / wiz-*.png / srv-*.png …）不进仓库。
/gui-react/*.png

# 内部交接文档（含测试服务器 IP / 账户名 / 构建路径 / 本机用户名），
# 只在本地与桌面知识库维护，不进公开仓库。
/项目上下文与总结.md

# 第三方作者油猴脚本参考（仅本地留存，不入库）
参考js脚本/
