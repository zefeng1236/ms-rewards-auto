# ============ 依赖 ============
node_modules/

# ============ 运行时数据（含敏感信息，严禁提交）============
# storage/ 包含账户 cookies、登录态、浏览器 profile、个人积分数据
storage/
storage-backup-migrate/

# ============ 日志 ============
logs/
*.log

# ============ WorkBuddy 工作区数据 ============
.workbuddy/

# ============ 系统/编辑器杂项 ============
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# ============ 临时文件 ============
*.tmp
*.bak
*.old

# ============ 打包产物 ============
# dist/ 是 electron-builder 的输出目录（安装包 77M，走 GitHub Release 分发）
dist/

# 注意：build/ 不能忽略。它是 electron-builder 的 buildResources 目录，
# 里面的 icon.ico / icon.png 是打包必需的输入，忽略了别人 clone 后
# 执行 npm run pack 会因找不到 build/icon.ico 直接失败。

# ============ 调试与临时输出（不提交） ============
/build/*.txt
/build/*.log
/icon-result*.txt
/icon-verify.txt
/build-web.txt
/pil-check.txt
/preview-u8.txt
/th-info.txt
/verify-out.txt
/shots/
/WinUI3Demo*/
